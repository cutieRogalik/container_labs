FROM python:3.11-slim AS builder

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir --prefix=/depend -r requirements.txt


FROM python:3.11-slim

LABEL maintainer="lishchuk@lab.local"
LABEL version="2.0"

WORKDIR /app

COPY --from=builder /depend /usr/local

COPY app/ ./app/

EXPOSE 5449

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5449/health', timeout=4)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5449"]
